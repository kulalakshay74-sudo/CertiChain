# CertiChain environment configuration
# Copy this file to .env and replace every CHANGE_ME value.

PORT=3000
RPC_URL=http://127.0.0.1:8545

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS

# Random secret, minimum 32 characters
SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM

# Local Hardhat issuer private key
# IMPORTANT: use only the private key printed by the local Hardhat node.
ISSUER_PRIVATE_KEY=0xCHANGE_ME

# Public URL used inside certificate QR verification links
PUBLIC_BASE_URL=http://localhost:3000

# SMTP email settings
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-16-character-gmail-app-password
# SMTP_FROM=your-gmail-address@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
